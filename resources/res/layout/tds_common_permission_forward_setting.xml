<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/tds_common_permission_alert_bg"
        android:layout_width="335dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/rl_permission_top"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:id="@+id/tv_permission_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_permission_close"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_margin="8dp"
                android:src="@drawable/tds_common_permission_close"
                android:scaleType="fitXY"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#333333"
            android:id="@+id/tv_permission_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:minLines="2"/>
        <LinearLayout
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:id="@+id/bt_permission_cancel"
                android:background="@drawable/tds_common_permission_negative_bg"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_weight="1"/>
            <Space
                android:layout_width="16dp"
                android:layout_height="match_parent"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/bt_permission_ok"
                android:background="@drawable/tds_common_permission_positive_bg"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

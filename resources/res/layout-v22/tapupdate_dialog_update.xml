<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_root_container"
    android:background="@drawable/tapupdate_bg_dialog_update"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_width="match_parent"
        android:layout_height="170dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_ready_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Space
            android:layout_width="0dp"
            android:layout_height="42dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginRight="22dp"
            android:minHeight="60dp"
            android:layout_marginHorizontal="22dp">
            <ImageView
                android:id="@+id/iv_request_error"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/tapupdate_icon_error"/>
            <Space
                android:layout_width="8dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:id="@+id/tv_ready_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingHorizontal="14dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:gravity="center"
                android:id="@+id/tv_func_negative"
                android:background="@drawable/tapupdate_selector_func_button_negative"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"/>
            <Space
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_func_positive"
                android:background="@drawable/tapupdate_selector_func_button_positive"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_download_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:id="@+id/tv_update_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:layout_marginStart="16dp"/>
            <ImageView
                android:id="@+id/iv_update_cancel"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_margin="9dp"
                android:src="@drawable/tapupdate_selector_close_button"/>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_progress_container"
                    android:paddingLeft="15dp"
                    android:paddingTop="22dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="22dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="22dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#868c92"
                            android:id="@+id/tv_download_content_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="10dp"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#868c92"
                            android:id="@+id/tv_download_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <Space
                            android:layout_width="3dp"
                            android:layout_height="0dp"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_speed_triangle"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/iv_download_speed_triangle_1"
                                android:layout_width="8dp"
                                android:layout_height="3.5dp"
                                android:src="@drawable/tapupdate_icon_download_speed_triangle"
                                android:alpha="0.5"/>
                            <Space
                                android:layout_width="0dp"
                                android:layout_height="2dp"/>
                            <ImageView
                                android:id="@+id/iv_download_speed_triangle_2"
                                android:layout_width="8dp"
                                android:layout_height="3.5dp"
                                android:src="@drawable/tapupdate_icon_download_speed_triangle"/>
                        </LinearLayout>
                    </LinearLayout>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="8dp"/>
                    <ProgressBar
                        android:id="@+id/pb_download_progress"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progressDrawable="@drawable/tapupdate_download_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="8dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#f64c4c"
                            android:ellipsize="end"
                            android:id="@+id/tv_error_tips"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_weight="1"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/ll_retry"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="12dp"
                                android:textStyle="bold"
                                android:textColor="#00d9c5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="点击此处重试"/>
                            <Space
                                android:layout_width="2dp"
                                android:layout_height="0dp"/>
                            <ImageView
                                android:id="@+id/iv_icon_retry"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/tapupdate_icon_retry"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#868c92"
                        android:id="@+id/tv_other_tips"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_func_container"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:paddingHorizontal="15dp">
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/tv_func_button"
                        android:background="@drawable/tapupdate_selector_func_button_positive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="228dp"
                        android:minHeight="34dp"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="8dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#868c92"
                        android:id="@+id/tv_func_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:paddingHorizontal="12dp">
            <Space
                android:layout_width="0dp"
                android:layout_height="7dp"/>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/flex_link_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dividerDrawable="@drawable/tapupdate_link_divider"
                app:flexDirection="row"
                app:flexWrap="wrap"
                app:showDividerVertical="middle"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="2dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#8e8e8e"
                android:id="@+id/tv_developer_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="7dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
